GEOAPIFY_API_KEY=
BEARINGS_HTTP_PORT=
BEARINGS_HTTP_HOST=
BEARINGS_ALLOWED_ORIGINS=

# Comma-separated hostnames accepted in the Host header (DNS-rebinding guard).
# Defaults to loopback (127.0.0.1, localhost, [::1]) plus BEARINGS_HTTP_HOST.
# Set this only when binding a real hostname. Port is not matched.
BEARINGS_ALLOWED_HOSTS=

# Dev-only: arms the fault-injection seam and its /__dev/faults control route.
# Unset in any real deployment — when unset the route is not registered at all.
BEARINGS_FAULT_INJECTION=
