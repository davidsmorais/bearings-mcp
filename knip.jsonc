{
  "$schema": "https://unpkg.com/knip@latest/overview.json",
  "workspaces": {
    ".": {},
    "packages/shared": {
      "project": ["src/**/*.ts!"]
    },
    // Barrel entry: upstream clients import getHttpCore from here, but the rest of the
    // http/ public surface stays test-only until the composed tool handlers land (DMS-497).
    "packages/server": {
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "entry": ["src/http/index.ts"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}!"]
    }
  }
}
