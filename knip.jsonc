{
  "$schema": "https://unpkg.com/knip@latest/overview.json",
  "workspaces": {
    ".": {},
    "packages/shared": {
      "project": ["src/**/*.ts!"]
    },
    // Barrel entry: production imports only getHttpCore from here; createHttpCore / HOST_CONFIG
    // and the re-exported http error types are consumed only by colocated *.test.ts files, so
    // src/http/index.ts is declared an entry to keep its full public surface from reading as dead.
    // test/**/*.ts covers the shared test helpers (test/fakeClock.ts); test/ has no test files.
    // scripts/measureTokenBudget.ts is run directly via the `measure:tokens` package.json
    // script (tsx), never imported by anything else — knip already treats a package.json
    // script's target file as an entry, so it only needs to be in `project` to be scanned
    // rather than reading as dead code.
    "packages/server": {
      "project": ["src/**/*.ts!", "test/**/*.ts", "scripts/**/*.ts"],
      "entry": ["src/http/index.ts"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}!"]
    }
  }
}
